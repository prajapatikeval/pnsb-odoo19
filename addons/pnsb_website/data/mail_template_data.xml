<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_rfq_acknowledgement" model="mail.template">
            <field name="name">Industrial Parts: Quote request received</field>
            <field name="model_id" ref="model_industrial_rfq"/>
            <field name="subject">We received your request {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="description">Sent automatically to the customer when a quote request is submitted from the website.</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f3f2ef;font-family:Helvetica,Arial,sans-serif;color:#15161a;">
    <table width="100%" cellpadding="0" cellspacing="0" style="padding:32px 0;">
        <tr><td align="center">
            <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:16px;overflow:hidden;">
                <tr><td style="background:#0b0c0e;padding:28px 36px;color:#ffffff;">
                    <div style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#ff5b1f;">Request for quotation</div>
                    <div style="font-size:26px;font-weight:700;margin-top:8px;" t-out="object.name or ''">RFQ/2026/0001</div>
                </td></tr>
                <tr><td style="padding:32px 36px;font-size:15px;line-height:1.6;">
                    <p style="margin:0 0 16px;">Hello <t t-out="object.contact_name or ''">Alex</t>,</p>
                    <p style="margin:0 0 16px;">Thank you for your request. Our team is reviewing it and will come back to you with pricing and lead times shortly.</p>
                    <t t-if="object.line_ids">
                        <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:8px 0 20px;font-size:13px;">
                            <tr style="background:#f3f2ef;">
                                <th align="left" style="padding:10px 12px;">Item</th>
                                <th align="left" style="padding:10px 12px;">Spec</th>
                                <th align="right" style="padding:10px 12px;">Qty</th>
                            </tr>
                            <tr t-foreach="object.line_ids" t-as="line" style="border-bottom:1px solid #ecebe7;">
                                <td style="padding:10px 12px;" t-out="line.name or ''">Hex bolt</td>
                                <td style="padding:10px 12px;color:#6b6e75;">
                                    <t t-out="' · '.join(v for v in [line.size, line.length, line.material, line.finish] if v)">M12 · 50 mm</t>
                                </td>
                                <td align="right" style="padding:10px 12px;" t-out="line.quantity">1000</td>
                            </tr>
                        </table>
                    </t>
                    <p style="margin:0;">Kind regards,<br/><t t-out="object.company_id.name or ''">Company</t></p>
                </td></tr>
            </table>
        </td></tr>
    </table>
</div>
            </field>
        </record>
    </data>
</odoo>
