<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product families -->
    <record id="industrial_product_view_form" model="ir.ui.view">
        <field name="name">industrial.product.form</field>
        <field name="model">industrial.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" widget="website_redirect_button"/>
                        <button name="action_view_rfq_lines" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="rfq_line_count" widget="statinfo" string="Quote Requests"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_256'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Hex Head Screw DIN 933"/></h1>
                        <field name="tagline" placeholder="Short marketing line shown under the title"/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="default_code"/>
                            <field name="standard"/>
                            <field name="grade"/>
                            <field name="thread_type"/>
                            <field name="head_type"/>
                            <field name="drive_type"/>
                        </group>
                        <group string="Commercial">
                            <field name="moq"/>
                            <field name="lead_time"/>
                            <field name="packaging"/>
                            <field name="is_featured"/>
                            <field name="ribbon"/>
                            <field name="size_range"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Rich description shown on the product page..."/>
                        </page>
                        <page string="Sizes &amp; Dimensions" name="sizes">
                            <group>
                                <group>
                                    <field name="drawing_type"/>
                                    <field name="dim_a_label"/>
                                    <field name="dim_b_label"/>
                                </group>
                                <group>
                                    <field name="torque_tool"/>
                                </group>
                            </group>
                            <field name="size_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="nominal_diameter"/>
                                    <field name="pitch"/>
                                    <field name="dim_a"/>
                                    <field name="dim_b"/>
                                    <field name="lengths"/>
                                    <field name="in_stock"/>
                                </list>
                            </field>
                        </page>
                        <page string="Specifications" name="specs">
                            <field name="spec_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="group"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Materials &amp; Industries" name="materials">
                            <group>
                                <field name="material_ids" widget="many2many_tags"/>
                                <field name="finish_ids" widget="many2many_tags"/>
                                <field name="sector_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Media" name="media">
                            <group>
                                <field name="image_url" widget="url"/>
                                <field name="datasheet" filename="datasheet_filename"/>
                                <field name="datasheet_filename" invisible="1"/>
                            </group>
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_1920" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="name"/>
                                    <field name="image_url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Website" name="website">
                            <group>
                                <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website"/>
                                <field name="website_meta_title"/>
                                <field name="website_meta_description"/>
                                <field name="website_meta_keywords"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="industrial_product_view_list" model="ir.ui.view">
        <field name="name">industrial.product.list</field>
        <field name="model">industrial.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_code" optional="show"/>
                <field name="category_id"/>
                <field name="standard" optional="show"/>
                <field name="grade" optional="show"/>
                <field name="size_range"/>
                <field name="moq" optional="hide"/>
                <field name="is_featured" widget="boolean_toggle" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="industrial_product_view_kanban" model="ir.ui.view">
        <field name="name">industrial.product.kanban</field>
        <field name="model">industrial.product</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="image_url"/>
                <field name="image_128"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field t-if="record.image_128.raw_value" name="image_128" widget="image" class="o_kanban_image_fill w-100" alt="Product"/>
                            <img t-elif="record.image_url.raw_value" t-att-src="record.image_url.raw_value + '?auto=compress&amp;cs=tinysrgb&amp;w=240'" class="w-100 h-100 object-fit-cover" alt="Product"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="category_id" class="text-muted"/>
                            <div class="mt-1">
                                <field name="standard" class="badge text-bg-light me-1"/>
                                <field name="size_range" class="badge text-bg-light"/>
                            </div>
                            <footer class="pt-1">
                                <field name="grade" class="small text-muted"/>
                                <span t-if="record.is_published.raw_value" class="badge text-bg-success ms-auto">Published</span>
                                <span t-else="" class="badge text-bg-secondary ms-auto">Draft</span>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="industrial_product_view_search" model="ir.ui.view">
        <field name="name">industrial.product.search</field>
        <field name="model">industrial.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('default_code', 'ilike', self), ('standard', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="material_ids"/>
                <field name="finish_ids"/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="industrial_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">industrial.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first product family</p>
            <p>Bolts, nuts, washers, rods or custom parts: each family gets its own page on the website.</p>
        </field>
    </record>
</odoo>
