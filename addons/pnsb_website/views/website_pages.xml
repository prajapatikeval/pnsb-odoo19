<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         About
    ====================================================================== -->
    <template id="page_about" name="PNSB: About">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title">About Us</t>
            <t t-call="pnsb_website.pn_page_hero">
                <t t-set="eyebrow">About us</t>
                <t t-set="title">Customized engineering. Diverse manufacturing. Reliable solutions.</t>
                <t t-set="part">seal</t>
                <t t-set="lead">A manufacturing and industrial solutions company focused on customized products, specialized assemblies and engineering requirements across diverse industries.</t>
            </t>

            <section class="pn-section pn-section--tight">
                <div class="pn-container pn-split">
                    <div class="pn-split__copy">
                        <p class="pn-eyebrow pn-reveal">Who we are</p>
                        <h2 class="pn-h2 pn-reveal">PNSB Machinery Industries</h2>
                        <p class="pn-reveal">
                            Established in 2019, PNSB Machinery Industries is a manufacturing and industrial solutions
                            company focused on customized products, specialized assemblies, and engineering requirements
                            across diverse industries.
                        </p>
                        <p class="pn-reveal">
                            We work with industrial customers and Original Equipment Manufacturers (OEMs) to develop and
                            supply products tailored to their specific applications and technical requirements. Our
                            approach combines practical engineering knowledge, customization, and a commitment to
                            understanding each customer's unique needs.
                        </p>
                        <p class="pn-reveal">
                            With a diverse product portfolio spanning electrical components, textile machinery parts,
                            specialized industrial products, customized fasteners, and metal assemblies, we aim to provide
                            flexible solutions for a wide range of industrial applications.
                        </p>
                    </div>
                    <div class="pn-split__media pn-reveal">
                        <figure class="pn-figure">
                            <img src="/pnsb_website/static/src/img/about-us.jpg" alt="Engineering team reviewing drawings at a project table"
                                 loading="lazy" width="678" height="452"/>
                        </figure>
                    </div>
                </div>
            </section>

            <section class="pn-section pn-section--soft">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">What we do</p>
                            <h2 class="pn-h2" data-pnsb-split="">A product portfolio across industrial segments.</h2>
                        </div>
                    </div>
                    <p class="pn-lead-text pn-reveal">
                        Our manufacturing and product portfolio covers multiple industrial segments: petroleum and
                        electrical components, textile machinery parts, surgical and laboratory instruments, specialized
                        industrial products, customized fasteners, and metal assemblies.
                    </p>
                    <div class="pn-cards3 pn-cards3--compact">
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">01</span>
                            <h3>Copper Busbars &amp; Surface Treatment</h3>
                            <p>Copper busbars and related components with surface treatment options to meet application-specific requirements in electrical and industrial systems.</p>
                        </div>
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">02</span>
                            <h3>Textile Machinery Components &amp; Assemblies</h3>
                            <p>Components for the textile industry, ranging from small screws and precision parts to larger assemblies such as creel assemblies.</p>
                        </div>
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">03</span>
                            <h3>Specialized Industrial Products</h3>
                            <p>Products for specialized applications across industries, including selected medical and surgical product categories, with specific product details kept confidential where required.</p>
                        </div>
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">04</span>
                            <h3>Petroleum Industry Products</h3>
                            <p>Industrial products and components intended for applications within the petroleum sector, developed according to relevant customer requirements.</p>
                        </div>
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">05</span>
                            <h3>Customized Screws &amp; Fasteners</h3>
                            <p>Customized screws, fasteners, and related components designed around specific dimensions, configurations, and application needs.</p>
                        </div>
                        <div class="pn-vcard pn-reveal">
                            <span class="pn-vcard__num">06</span>
                            <h3>Aluminum Honeycomb Assemblies &amp; Metal Solutions</h3>
                            <p>Aluminum honeycomb assemblies and products involving different metals, supporting varied industrial and engineering applications.</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pn-section">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">What we support</p>
                            <h2 class="pn-h2" data-pnsb-split="">From the first idea to the existing product line.</h2>
                        </div>
                    </div>
                    <dl class="pn-spec pn-spec--wide pn-reveal">
                        <div><dt>Product design</dt><dd>Design for your conceptual idea or an existing product, through the complete cycle of product development.</dd></div>
                        <div><dt>Prototype development</dt><dd>Top-notch services from concept to prototype development.</dd></div>
                        <div><dt>Component engineering</dt><dd>Engineering of components and assemblies for function, fit and manufacturability.</dd></div>
                        <div><dt>Material cost reduction</dt><dd>Reviewing materials and processes to bring the cost of a part down.</dd></div>
                        <div><dt>Certification &amp; testing</dt><dd>Support through certification and testing against approval standards.</dd></div>
                        <div><dt>Existing products</dt><dd>Improving products already in production and reducing their time cycle.</dd></div>
                        <div><dt>Your suppliers</dt><dd>We evaluate, adopt, equip and collaborate with your current manufacturers.</dd></div>
                        <div><dt>Continuous production</dt><dd>Production with consideration of quality and approval standards, plus spare assembly parts.</dd></div>
                    </dl>
                </div>
            </section>

            <section class="pn-section pn-section--soft">
                <div class="pn-container pn-split pn-split--reverse">
                    <div class="pn-split__copy">
                        <p class="pn-eyebrow pn-reveal">On the shop floor</p>
                        <h2 class="pn-h2 pn-reveal">Better products, shorter cycles.</h2>
                        <p class="pn-reveal">
                            At the existing-product stage we help improve the product and reduce its time cycle. We will
                            be happy to evaluate, adopt, equip and collaborate with your current manufacturers to achieve
                            the required results.
                        </p>
                        <ul class="pn-ticks pn-reveal">
                            <li><svg class="pn-i"><use href="#pn-i-check"/></svg>Component engineering</li>
                            <li><svg class="pn-i"><use href="#pn-i-check"/></svg>Material cost reduction</li>
                            <li><svg class="pn-i"><use href="#pn-i-check"/></svg>Certification &amp; testing support</li>
                            <li><svg class="pn-i"><use href="#pn-i-check"/></svg>Spare assembly parts on request</li>
                        </ul>
                    </div>
                    <div class="pn-split__media pn-reveal">
                        <div class="pn-collage">
                            <img src="/pnsb_website/static/src/img/work/breather-box-set.jpg" alt="Sets of breather filtering boxes" loading="lazy" width="679" height="510"/>
                            <img src="/pnsb_website/static/src/img/work/rotating-assembly.jpg" alt="Rotating assembly" loading="lazy" width="642" height="584"/>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pn-section pn-section--navy">
                <div class="pn-container pn-quote pn-reveal">
                    <p class="pn-quote__text">
                        Whatever the scale or category of the product or project, we go about stubbornly finding the most
                        resourceful way to get it done. We love to try new things, learn new technologies and solve new
                        problems.
                    </p>
                    <p class="pn-quote__by">Think of us as your extended innovation-cum-R&amp;D arm.</p>
                </div>
            </section>

            <div class="oe_structure" id="pn_about_extra"/>
            <t t-call="pnsb_website.pn_cta"/>
        </t>
    </template>

    <!-- =====================================================================
         Services
    ====================================================================== -->
    <template id="page_services" name="PNSB: Services">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title">Services</t>
            <t t-call="pnsb_website.pn_page_hero">
                <t t-set="eyebrow">Services</t>
                <t t-set="title">From concept to continuous production.</t>
                <t t-set="part">sprocket</t>
                <t t-set="lead">Six ways we support your product, whether it is still an idea or already in production.</t>
            </t>
            <t t-set="service_images" t-value="{
                'design': ('yarn-condensing.jpg', 459, 598),
                'prototype': ('honeycomb-screen.jpg', 535, 428),
                'manufacturing': ('machined-spares.jpg', 843, 562),
                'component': ('mechanical-seal-2.jpg', 423, 318),
                'improvement': ('tension-device-2.jpg', 780, 565),
                'certification': ('milled-components.jpg', 800, 600),
            }"/>
            <section class="pn-section pn-section--tight">
                <div class="pn-container">
                    <div class="pn-services">
                        <article t-foreach="pnsb_services" t-as="service" t-attf-id="service-#{service[0]}"
                                 t-attf-class="pn-service #{'pn-service--reverse' if service_index % 2 else ''}">
                            <t t-set="img" t-value="service_images.get(service[0])"/>
                            <figure class="pn-service__media pn-reveal">
                                <img t-attf-src="/pnsb_website/static/src/img/work/#{img[0]}" t-att-alt="service[1]"
                                     loading="lazy" t-attf-width="#{img[1]}" t-attf-height="#{img[2]}"/>
                            </figure>
                            <div class="pn-service__body pn-reveal">
                                <span class="pn-service__num"><t t-out="'%02d' % (service_index + 1)"/></span>
                                <h2 class="pn-h3"><svg class="pn-i pn-i--lg"><use t-attf-href="#pn-i-#{service[0]}"/></svg><t t-out="service[1]"/></h2>
                                <p t-out="service[2]"/>
                                <a href="/contact" class="pn-link">Discuss this service <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            <section class="pn-section pn-section--soft">
                <div class="pn-container">
                    <div class="pn-head pn-head--center">
                        <p class="pn-eyebrow pn-reveal">Workshop</p>
                        <h2 class="pn-h2 pn-reveal">Processes we work with.</h2>
                    </div>
                    <div class="pn-pills pn-reveal">
                        <span>Turning</span><span>VMC and CNC</span><span>Drilling and Tapping</span>
                        <span>Laser Cutting, Bending and Welding</span><span>Surface Treatment</span>
                        <span>Component Assembly</span>
                    </div>
                </div>
            </section>

            <div class="oe_structure" id="pn_services_extra"/>
            <t t-call="pnsb_website.pn_cta"/>
        </t>
    </template>

    <!-- =====================================================================
         Industries
    ====================================================================== -->
    <template id="page_industries" name="PNSB: Industries">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title">Industries</t>
            <t t-call="pnsb_website.pn_page_hero">
                <t t-set="eyebrow">Industries</t>
                <t t-set="title">Engineering for the industries that make things.</t>
                <t t-set="part">honeycomb</t>
                <t t-set="lead">Our team's design and manufacturing work has supported products across these industries.</t>
            </t>
            <!-- Industry explorer: the list drives a sticky drawing sheet (hover, click or scroll) -->
            <section class="pn-section pn-section--tight pn-ind" data-pnsb-industries="">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">Industries · <t t-out="'%02d' % len(pnsb_industries)"/></p>
                            <t t-set="count_words" t-value="['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve']"/>
                            <h2 class="pn-h2" data-pnsb-split="">One engineering partner, <em><t t-out="count_words[len(pnsb_industries)] if len(pnsb_industries) &lt; 13 else len(pnsb_industries)"/> <t t-out="'industry' if len(pnsb_industries) == 1 else 'industries'"/>.</em></h2>
                        </div>
                        <a href="/contact" class="pn-link pn-reveal">Discuss your part <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-ind__grid">
                        <ol class="pn-ind__list">
                            <li t-foreach="pnsb_industries" t-as="industry" t-attf-id="industry-#{industry.url_key}"
                                t-attf-class="pn-ind__item #{'is-active' if industry_first else ''}" t-attf-data-pnsb-ind="#{industry_index}"
                                t-att-data-pnsb-ind-url="industry.website_url" t-att-data-pnsb-ind-name="industry.name">
                                <a t-att-href="industry.website_url" class="pn-ind__btn">
                                    <span class="pn-ind__num" t-out="'%02d' % (industry_index + 1)"/>
                                    <span class="pn-ind__name" t-out="industry.name"/>
                                    <svg class="pn-i pn-ind__go" aria-hidden="true"><use href="#pn-i-arrow"/></svg>
                                </a>
                                <div class="pn-ind__inline">
                                    <span class="pn-ind__icon" aria-hidden="true"><svg class="pn-i pn-i--lg"><use t-attf-href="#pn-i-#{industry.icon}"/></svg></span>
                                    <div>
                                        <p t-out="industry.summary"/>
                                        <a t-att-href="industry.website_url" class="pn-link pn-link--sm">View industry <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                                    </div>
                                </div>
                            </li>
                        </ol>

                        <div class="pn-ind__sheet">
                            <div class="pn-ind__ruler" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
                            <div class="pn-ind__body">
                                <div t-foreach="pnsb_industries" t-as="industry"
                                     t-attf-class="pn-ind__panel #{'is-active' if industry_first else ''}" t-attf-data-pnsb-ind-panel="#{industry_index}">
                                    <div class="pn-ind__canvas">
                                        <span class="pn-ind__detail">Detail <t t-out="'%02d' % (industry_index + 1)"/> · <t t-out="industry.name"/></span>
                                        <svg class="pn-ind__art" viewBox="0 0 24 24" aria-hidden="true"><use t-attf-href="#pn-i-#{industry.icon}"/></svg>
                                        <span class="pn-ind__big" aria-hidden="true" t-out="'%02d' % (industry_index + 1)"/>
                                        <span class="pn-ind__dim" aria-hidden="true"><span>IND-<t t-out="'%02d' % (industry_index + 1)"/></span></span>
                                    </div>
                                    <table class="pn-ind__block">
                                        <tr><th>Industry</th><td class="pn-ind__block-name" t-out="industry.name"/></tr>
                                        <tr><th>Scope</th><td class="pn-ind__block-scope" t-out="industry.summary"/></tr>
                                        <tr><th>Sheet</th><td class="pn-ind__block-sheet"><t t-out="'%02d' % (industry_index + 1)"/> / <t t-out="'%02d' % len(pnsb_industries)"/></td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="pn-ind__cta">
                                <a t-att-href="pnsb_industries[:1].website_url" class="pn-btn pn-btn--outline pn-btn--lg" data-pnsb-ind-open="">View industry <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                                <a href="/contact" class="pn-btn pn-btn--dark pn-btn--lg">Request a Quote <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="pn-section pn-section--soft">
                <div class="pn-container pn-split">
                    <div class="pn-split__copy">
                        <p class="pn-eyebrow pn-reveal">Not on the list?</p>
                        <h2 class="pn-h2 pn-reveal">We love new problems.</h2>
                        <p class="pn-reveal">
                            We enjoy learning new technologies and understanding new products. If your industry is not
                            listed, tell us what you need and we will tell you honestly how we can help.
                        </p>
                        <a href="/contact" class="pn-btn pn-btn--dark pn-reveal">Request a Quote <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-split__media pn-split__media--desktop pn-reveal">
                        <figure class="pn-figure">
                            <img src="/pnsb_website/static/src/img/work/honeycomb.jpg" alt="Honeycomb screen media" loading="lazy" width="1135" height="501"/>
                        </figure>
                    </div>
                </div>
            </section>
            <div class="oe_structure" id="pn_industries_extra"/>
            <t t-call="pnsb_website.pn_cta"/>
        </t>
    </template>

    <!-- =====================================================================
         Industry page (/industries/<key>), content from Machinery › Industries
    ====================================================================== -->
    <template id="page_industry" name="PNSB: Industry">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title" t-value="industry.name"/>
            <t t-set="sheet_no" t-value="'%02d' % (industry_index + 1)"/>
            <section class="pn-phero pn-ihero">
                <div class="pn-hero__grid-bg" aria-hidden="true"/>
                <div class="pn-container pn-ihero__grid">
                    <div>
                        <nav class="pn-crumbs pn-reveal" aria-label="Breadcrumb">
                            <a href="/industries">Industries</a><span aria-hidden="true">/</span><span t-out="industry.name"/>
                        </nav>
                        <p class="pn-eyebrow pn-reveal">Industry · <t t-out="sheet_no"/></p>
                        <h1 class="pn-phero__title pn-reveal" t-out="industry.name"/>
                        <p class="pn-phero__lead pn-reveal" t-out="industry.summary"/>
                        <div class="pn-hero__actions pn-reveal">
                            <a href="/contact" class="pn-btn pn-btn--dark pn-btn--lg">Request a Quote <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                            <a t-if="products" href="#industry-products" class="pn-btn pn-btn--outline pn-btn--lg">See products</a>
                        </div>
                    </div>
                    <div class="pn-ind__sheet pn-ihero__sheet pn-reveal">
                        <div class="pn-ind__ruler" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
                        <div class="pn-ind__panel is-active">
                            <div class="pn-ind__canvas">
                                <span class="pn-ind__detail">Detail <t t-out="sheet_no"/> · <t t-out="industry.name"/></span>
                                <svg class="pn-ind__art" viewBox="0 0 24 24" aria-hidden="true"><use t-attf-href="#pn-i-#{industry.icon}"/></svg>
                                <span class="pn-ind__big" aria-hidden="true" t-out="sheet_no"/>
                                <span class="pn-ind__dim" aria-hidden="true"><span>IND-<t t-out="sheet_no"/></span></span>
                            </div>
                            <table class="pn-ind__block">
                                <tr><th>Industry</th><td class="pn-ind__block-name" t-out="industry.name"/></tr>
                                <tr><th>Work</th><td class="pn-ind__block-sheet">Made to your drawing or sample</td></tr>
                                <tr><th>Sheet</th><td class="pn-ind__block-sheet"><t t-out="sheet_no"/> / <t t-out="'%02d' % industry_total"/></td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <section t-if="(industry.description and not is_html_empty(industry.description)) or industry.image" class="pn-section pn-section--tight">
                <div t-attf-class="pn-container #{'pn-split' if industry.image else ''}">
                    <div class="pn-split__copy pn-ihero__content pn-reveal">
                        <t t-if="industry.description and not is_html_empty(industry.description)" t-out="industry.description"/>
                    </div>
                    <div t-if="industry.image" class="pn-split__media pn-reveal">
                        <figure class="pn-figure">
                            <img t-att-src="industry._pnsb_image_url()" t-att-alt="industry.name" loading="lazy"/>
                        </figure>
                    </div>
                </div>
            </section>

            <section t-if="products" id="industry-products" class="pn-section pn-section--soft">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">Products</p>
                            <h2 class="pn-h2" data-pnsb-split="">Parts we make for <em t-out="industry.name"/>.</h2>
                        </div>
                        <a href="/products" class="pn-link pn-reveal">All products <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-products">
                        <t t-foreach="products" t-as="product">
                            <t t-call="pnsb_website.pn_product_card"/>
                        </t>
                    </div>
                </div>
            </section>

            <section t-if="other_industries" class="pn-section">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">Other industries</p>
                            <h2 class="pn-h2" data-pnsb-split="">Where else our parts go to work.</h2>
                        </div>
                        <a href="/industries" class="pn-link pn-reveal">All industries <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-industries">
                        <a t-foreach="other_industries" t-as="other" t-att-href="other.website_url" class="pn-industry pn-industry--link pn-reveal">
                            <span class="pn-industry__icon"><svg class="pn-i pn-i--lg"><use t-attf-href="#pn-i-#{other.icon}"/></svg></span>
                            <h3 class="pn-industry__title" t-out="other.name"/>
                            <p t-out="other.summary"/>
                            <svg class="pn-i pn-industry__go" aria-hidden="true"><use href="#pn-i-arrow-ur"/></svg>
                        </a>
                    </div>
                </div>
            </section>

            <div class="oe_structure" id="pn_industry_extra"/>
            <t t-call="pnsb_website.pn_cta"/>
        </t>
    </template>
</odoo>
