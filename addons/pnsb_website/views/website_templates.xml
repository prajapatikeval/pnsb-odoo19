<odoo>
<t t-name="pnsb_website.home_page"><t t-call="website.layout"><div id="wrap">
<header class="pnsb-navbar"><div class="pnsb-container"><a href="/" class="pnsb-logo"><span class="pnsb-logo-main">PNSB</span><span class="pnsb-logo-sub">MACHINERY INDUSTRIES</span></a><nav><a href="/">Home</a><a href="/products">Products</a><a href="/contact">Contact</a><a href="/contact" class="pnsb-nav-button">Get In Touch</a></nav></div></header>
<section class="pnsb-hero"><div class="pnsb-container pnsb-hero-grid"><div class="pnsb-hero-content"><div class="pnsb-eyebrow">ENGINEERING • PRECISION • PERFORMANCE</div><h1>Precision Machinery. <span>Built for Industry.</span></h1><p>Advanced machinery solutions engineered for demanding industrial applications. Built with precision, reliability and performance at the core.</p><div class="pnsb-hero-actions"><a href="/products" class="pnsb-button pnsb-button-primary">Explore Products</a><a href="/contact" class="pnsb-button pnsb-button-outline">Contact Us</a></div></div><div class="pnsb-hero-visual"><div class="pnsb-machine-placeholder"><div class="pnsb-machine-grid"/><div class="pnsb-machine-label">PNSB ENGINEERING</div></div></div></div></section>
<section class="pnsb-section"><div class="pnsb-container"><div class="pnsb-section-heading"><span>WHO WE ARE</span><h2>Engineering the future of industrial machinery.</h2></div><div class="pnsb-about-grid"><div><p class="pnsb-large-text">PNSB Machinery Industries delivers dependable industrial machinery and precision-engineered components designed for modern manufacturing.</p></div><div><p>Our approach combines engineering expertise, quality manufacturing and practical industrial knowledge to create solutions that perform consistently in demanding environments.</p><a href="/contact">Talk to our team →</a></div></div></div></section>
<section class="pnsb-section pnsb-dark"><div class="pnsb-container"><div class="pnsb-section-heading light"><span>OUR CAPABILITIES</span><h2>Built around precision.</h2></div><div class="pnsb-capabilities"><div class="pnsb-capability"><span class="pnsb-number">01</span><h3>Precision Engineering</h3><p>Engineered components and machinery designed to meet demanding industrial requirements.</p></div><div class="pnsb-capability"><span class="pnsb-number">02</span><h3>Custom Solutions</h3><p>Machinery and components developed around your exact application.</p></div><div class="pnsb-capability"><span class="pnsb-number">03</span><h3>Industrial Reliability</h3><p>Solutions built for continuous industrial performance.</p></div></div></div></section>
<section class="pnsb-section"><div class="pnsb-container"><div class="pnsb-section-heading"><span>OUR PRODUCTS</span><h2>Machinery that means business.</h2></div><div class="pnsb-products-grid"><t t-foreach="products" t-as="product"><article class="pnsb-product-card"><div class="pnsb-product-image"><img t-if="product.image" t-att-src="'/web/image/pnsb.product/%s/image' % product.id"/><div t-if="not product.image" class="pnsb-product-placeholder">PNSB</div></div><div class="pnsb-product-content"><span><t t-esc="product.category"/></span><h3><t t-esc="product.name"/></h3><p><t t-esc="product.description"/></p></div></article></t></div></div></section>
<section class="pnsb-cta"><div class="pnsb-container"><div><span>HAVE A PROJECT?</span><h2>Let's build something precise.</h2></div><a href="/contact" class="pnsb-button pnsb-button-light">Start a Conversation →</a></div></section>
<footer class="pnsb-footer"><div class="pnsb-container"><div><div class="pnsb-footer-logo">PNSB</div><p>Precision machinery for modern industry.</p></div><div><h4>Navigation</h4><a href="/">Home</a><a href="/products">Products</a><a href="/contact">Contact</a></div><div><h4>Contact</h4><p>Ahmedabad, Gujarat, India</p><a href="/contact">Send an enquiry</a></div></div><div class="pnsb-footer-bottom">© 2026 PNSB Machinery Industries. All rights reserved.</div></footer>
</div></t></t>
<t t-name="pnsb_website.products_page"><t t-call="website.layout"><div id="wrap"><section class="pnsb-page-header"><div class="pnsb-container"><span>OUR PRODUCTS</span><h1>Engineered for performance.</h1></div></section><section class="pnsb-section"><div class="pnsb-container"><div class="pnsb-products-grid"><t t-foreach="products" t-as="product"><article class="pnsb-product-card"><div class="pnsb-product-image"><img t-if="product.image" t-att-src="'/web/image/pnsb.product/%s/image' % product.id"/><div t-if="not product.image" class="pnsb-product-placeholder">PNSB</div></div><div class="pnsb-product-content"><span><t t-esc="product.category"/></span><h3><t t-esc="product.name"/></h3><p><t t-esc="product.description"/></p></div></article></t></div></div></section></div></t></t>
<t t-name="pnsb_website.contact_page"><t t-call="website.layout"><div id="wrap"><section class="pnsb-page-header"><div class="pnsb-container"><span>CONTACT</span><h1>Let's discuss your requirement.</h1></div></section><section class="pnsb-section"><div class="pnsb-container pnsb-contact-grid"><div><span class="pnsb-eyebrow">GET IN TOUCH</span><h2>Tell us what you're building.</h2><p>Share your requirement and our team will get back to you.</p><div class="pnsb-contact-detail"><strong>Location</strong><span>Ahmedabad, Gujarat, India</span></div></div><div><t t-if="success"><div class="pnsb-success">Thank you. Your enquiry has been received.</div></t><form method="post" class="pnsb-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label>Name<input type="text" name="name" required="required"/></label><label>Email<input type="email" name="email"/></label><label>Phone<input type="tel" name="phone"/></label><label>Company<input type="text" name="company"/></label><label>Message<textarea name="message" rows="6"></textarea></label><button type="submit" class="pnsb-button pnsb-button-dark">Send Enquiry</button></form></div></div></section></div></t></t>
</odoo>
