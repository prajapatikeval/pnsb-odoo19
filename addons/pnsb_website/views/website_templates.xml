<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Reusable PNSB navigation -->
    <template id="pnsb_nav" name="PNSB Navigation">
        <header class="pnsb-nav">
            <div class="pnsb-container pnsb-nav-inner">
                <a href="/" class="pnsb-brand">
                    PNSB
                    <small>MACHINERY INDUSTRIES</small>
                </a>
                <nav class="pnsb-links">
                    <a href="/">Home</a>
                    <a href="/products">Products</a>
                    <a href="/about">About</a>
                    <a href="/process">Process</a>
                    <a href="/contact" class="pnsb-quote">Get In Touch</a>
                </nav>
            </div>
        </header>
    </template>

    <!-- Reusable PNSB footer -->
    <template id="pnsb_footer" name="PNSB Footer">
        <footer class="pnsb-footer">
            <div class="pnsb-container pnsb-footer-grid">
                <div>
                    <div class="pnsb-brand">PNSB</div>
                    <p>Precision machinery for modern industry.</p>
                </div>
                <div>
                    <b>Explore</b>
                    <a href="/">Home</a>
                    <a href="/products">Products</a>
                    <a href="/about">About</a>
                    <a href="/process">Process</a>
                </div>
                <div>
                    <b>Connect</b>
                    <p>Ahmedabad, Gujarat, India</p>
                    <a href="/contact">Start a conversation →</a>
                </div>
            </div>
            <div class="pnsb-bottom">© 2026 PNSB Machinery Industries. All rights reserved.</div>
        </footer>
    </template>

    <!-- Home -->
    <template id="home_page" name="PNSB Home Page">
        <t t-call="website.layout">
            <div id="wrap">
                <t t-call="pnsb_website.pnsb_nav"/>

                <main>
                    <section class="pnsb-hero">
                        <div class="pnsb-container pnsb-hero-grid">
                            <div>
                                <div class="pnsb-kicker">ENGINEERING • PRECISION • PERFORMANCE</div>
                                <h1>Precision Machinery.<br/><em>Built for Industry.</em></h1>
                                <p>
                                    Advanced machinery solutions engineered for demanding industrial
                                    applications. Built with precision, reliability and performance at the core.
                                </p>
                                <div class="pnsb-actions">
                                    <a href="/products" class="pnsb-btn pnsb-black">Explore Products</a>
                                    <a href="/contact" class="pnsb-btn pnsb-outline">Contact Us</a>
                                </div>
                            </div>
                            <div class="pnsb-visual"/>
                        </div>
                    </section>

                    <section class="pnsb-section">
                        <div class="pnsb-container">
                            <div class="pnsb-heading">
                                <span>WHO WE ARE</span>
                                <h2>Engineering the future of industrial machinery.</h2>
                            </div>
                            <div class="pnsb-about">
                                <p class="lead">
                                    PNSB Machinery Industries delivers dependable industrial machinery
                                    and precision-engineered components designed for modern manufacturing.
                                </p>
                                <p>
                                    Our approach combines engineering expertise, quality manufacturing
                                    and practical industrial knowledge to create solutions that perform
                                    consistently in demanding environments.
                                </p>
                            </div>
                        </div>
                    </section>

                    <section class="pnsb-section pnsb-dark">
                        <div class="pnsb-container">
                            <div class="pnsb-heading">
                                <span>OUR CAPABILITIES</span>
                                <h2>Built around precision.</h2>
                            </div>
                            <div class="pnsb-cards">
                                <article class="pnsb-card">
                                    <b>01</b>
                                    <h3>Precision Engineering</h3>
                                    <p>Engineered components and machinery designed to meet demanding industrial requirements.</p>
                                </article>
                                <article class="pnsb-card">
                                    <b>02</b>
                                    <h3>Custom Solutions</h3>
                                    <p>Machinery and components developed around your exact application.</p>
                                </article>
                                <article class="pnsb-card">
                                    <b>03</b>
                                    <h3>Industrial Reliability</h3>
                                    <p>Solutions built for continuous industrial performance.</p>
                                </article>
                            </div>
                        </div>
                    </section>

                    <section class="pnsb-section">
                        <div class="pnsb-container">
                            <div class="pnsb-heading">
                                <span>OUR PRODUCTS</span>
                                <h2>Machinery that means business.</h2>
                            </div>

                            <div class="pnsb-products">
                                <t t-foreach="products" t-as="product">
                                    <article class="pnsb-product">
                                        <div class="pnsb-product-media">
                                            <img t-if="product.image"
                                                 t-att-src="'/web/image/pnsb.product/%s/image' % product.id"
                                                 t-att-alt="product.name"/>
                                            <span t-if="not product.image">PNSB</span>
                                        </div>
                                        <div class="pnsb-product-body">
                                            <small><t t-esc="product.category or ''"/></small>
                                            <h3><t t-esc="product.name"/></h3>
                                            <p><t t-esc="product.description or ''"/></p>
                                        </div>
                                    </article>
                                </t>
                            </div>
                        </div>
                    </section>

                    <section class="pnsb-cta">
                        <div class="pnsb-container pnsb-cta-inner">
                            <h2>Let's build something precise.</h2>
                            <a href="/contact"
                               class="pnsb-btn pnsb-outline"
                               style="color:#fff;border-color:#fff">
                                Start a Conversation →
                            </a>
                        </div>
                    </section>
                </main>

                <t t-call="pnsb_website.pnsb_footer"/>
            </div>
        </t>
    </template>

    <!-- Products -->
    <template id="products_page" name="PNSB Products Page">
        <t t-call="website.layout">
            <div id="wrap">
                <t t-call="pnsb_website.pnsb_nav"/>

                <section class="pnsb-page">
                    <div class="pnsb-container">
                        <div class="pnsb-kicker">OUR PRODUCTS</div>
                        <h1>Engineered for performance.</h1>

                        <div class="pnsb-products">
                            <t t-foreach="products" t-as="product">
                                <article class="pnsb-product">
                                    <div class="pnsb-product-media">
                                        <img t-if="product.image"
                                             t-att-src="'/web/image/pnsb.product/%s/image' % product.id"
                                             t-att-alt="product.name"/>
                                        <span t-if="not product.image">PNSB</span>
                                    </div>
                                    <div class="pnsb-product-body">
                                        <small><t t-esc="product.category or ''"/></small>
                                        <h3><t t-esc="product.name"/></h3>
                                        <p><t t-esc="product.description or ''"/></p>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </div>
                </section>

                <t t-call="pnsb_website.pnsb_footer"/>
            </div>
        </t>
    </template>

    <!-- About -->
    <template id="about_page" name="PNSB About Page">
        <t t-call="website.layout">
            <div id="wrap">
                <t t-call="pnsb_website.pnsb_nav"/>

                <section class="pnsb-page">
                    <div class="pnsb-container">
                        <div class="pnsb-kicker">ABOUT PNSB</div>
                        <h1>Engineering with purpose.</h1>
                        <div class="pnsb-about" style="margin-top:80px">
                            <p class="lead">
                                We build practical industrial machinery around precision,
                                reliability and the needs of modern manufacturing.
                            </p>
                            <p>
                                From engineering through delivery, our focus is straightforward:
                                create dependable solutions that work in the real world.
                            </p>
                        </div>
                    </div>
                </section>

                <t t-call="pnsb_website.pnsb_footer"/>
            </div>
        </t>
    </template>

    <!-- Process -->
    <template id="process_page" name="PNSB Process Page">
        <t t-call="website.layout">
            <div id="wrap">
                <t t-call="pnsb_website.pnsb_nav"/>

                <section class="pnsb-page">
                    <div class="pnsb-container">
                        <div class="pnsb-kicker">OUR PROCESS</div>
                        <h1>From requirement to reality.</h1>

                        <div class="pnsb-process" style="margin-top:80px">
                            <article>
                                <b>01</b>
                                <h3>Understand</h3>
                                <p>We understand your application, requirements and operating conditions.</p>
                            </article>
                            <article>
                                <b>02</b>
                                <h3>Engineer</h3>
                                <p>We translate requirements into a practical engineering solution.</p>
                            </article>
                            <article>
                                <b>03</b>
                                <h3>Build</h3>
                                <p>Components and machinery are produced with precision and quality in mind.</p>
                            </article>
                            <article>
                                <b>04</b>
                                <h3>Deliver</h3>
                                <p>We deliver a dependable solution ready for industrial use.</p>
                            </article>
                        </div>
                    </div>
                </section>

                <t t-call="pnsb_website.pnsb_footer"/>
            </div>
        </t>
    </template>

    <!-- Contact -->
    <template id="contact_page" name="PNSB Contact Page">
        <t t-call="website.layout">
            <div id="wrap">
                <t t-call="pnsb_website.pnsb_nav"/>

                <section class="pnsb-page">
                    <div class="pnsb-container pnsb-contact">
                        <div>
                            <div class="pnsb-kicker">GET IN TOUCH</div>
                            <h2>Let's discuss your requirement.</h2>
                            <p>Share your requirement and our team will get back to you.</p>
                        </div>

                        <div>
                            <t t-if="success">
                                <div class="pnsb-success">
                                    Thank you. Your enquiry has been received.
                                </div>
                            </t>

                            <form method="post" class="pnsb-form">
                                <input type="hidden"
                                       name="csrf_token"
                                       t-att-value="request.csrf_token()"/>

                                <label>
                                    Name
                                    <input name="name" required="required"/>
                                </label>

                                <label>
                                    Email
                                    <input name="email" type="email"/>
                                </label>

                                <label>
                                    Phone
                                    <input name="phone"/>
                                </label>

                                <label>
                                    Company
                                    <input name="company"/>
                                </label>

                                <label>
                                    Message
                                    <textarea name="message" rows="6"/>
                                </label>

                                <button type="submit" class="pnsb-btn pnsb-black">
                                    Send Enquiry
                                </button>
                            </form>
                        </div>
                    </div>
                </section>

                <t t-call="pnsb_website.pnsb_footer"/>
            </div>
        </t>
    </template>

</odoo>
