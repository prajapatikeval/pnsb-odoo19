<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Products: Odoo eCommerce's /shop rendered with PNSB templates
         (controllers/shop.py). No prices, no cart: "Add to enquiry".
    ====================================================================== -->
    <template id="shop_products" name="PNSB: Shop">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title" t-value="category.name if category else 'Products &amp; Work'"/>
            <t t-call="pnsb_website.pn_page_hero">
                <t t-set="eyebrow">Products &amp; work</t>
                <t t-set="title">Turning ideas into real products.</t>
                <t t-set="part">pulley</t>
                <t t-set="lead">A selection of what we design, develop and manufacture. Add items to your enquiry list and we will come back with a quotation.</t>
            </t>

            <section class="pn-section pn-section--tight">
                <div class="pn-container">
                    <div class="pn-catalog">
                        <aside class="pn-catalog__side pn-shopnav" aria-label="Find products">
                            <form method="get" t-att-action="pnsb_shop_path" class="pn-shopnav__search" role="search">
                                <label class="pn-catalog__label" for="pn-shop-search">Search</label>
                                <span class="pn-catalog__field">
                                    <svg class="pn-i"><use href="#pn-i-search"/></svg>
                                    <input id="pn-shop-search" type="search" name="search" t-att-value="search"
                                           placeholder="Part name or application"/>
                                </span>
                            </form>
                            <div class="pn-shopnav__head">
                                <span>Product categories</span>
                                <span t-out="'%02d' % len(pnsb_shop_categories)"/>
                            </div>
                            <nav class="pn-shopnav__list" aria-label="Product categories">
                                <a href="/shop" t-attf-class="pn-shopnav__item #{'' if category else 'is-active'}">
                                    <span class="pn-shopnav__name">All products</span>
                                    <span class="pn-shopnav__count" t-out="pnsb_total"/>
                                </a>
                                <a t-foreach="pnsb_shop_categories" t-as="entry" t-att-href="entry['url']"
                                   t-attf-class="pn-shopnav__item #{'is-active' if category and category.id == entry['category'].id else ''}">
                                    <span class="pn-shopnav__name" t-out="entry['category'].name"/>
                                    <span class="pn-shopnav__count" t-out="entry['count']"/>
                                </a>
                            </nav>
                            <p class="pn-shopnav__foot">
                                <span t-out="search_count"/> <t t-out="'product' if search_count == 1 else 'products'"/> shown
                            </p>
                        </aside>

                        <div class="pn-catalog__main">
                            <p t-if="search" class="pn-line-intro">
                                Results for "<t t-out="search"/>" · <a t-att-href="pnsb_shop_path">Clear search</a>
                            </p>
                            <div t-if="pnsb_products" class="pn-products">
                                <t t-foreach="pnsb_products" t-as="product">
                                    <t t-call="pnsb_website.pn_product_card"/>
                                </t>
                            </div>
                            <div t-else="" class="pn-empty">
                                <svg class="pn-i pn-i--lg"><use href="#pn-i-search"/></svg>
                                <p>No products match your search.</p>
                                <p class="pn-muted">We also make parts to your drawing or sample: <a href="/contact">send us your requirement</a>.</p>
                            </div>
                            <nav t-if="pager and pager.get('page_count', 1) &gt; 1" class="pn-pager" aria-label="Pages">
                                <a t-if="pager['page']['num'] &gt; 1" t-att-href="pager['page_previous']['url']" class="pn-btn pn-btn--outline pn-btn--sm">Previous</a>
                                <span>Page <t t-out="pager['page']['num']"/> of <t t-out="pager['page_count']"/></span>
                                <a t-if="pager['page']['num'] &lt; pager['page_count']" t-att-href="pager['page_next']['url']" class="pn-btn pn-btn--outline pn-btn--sm">Next</a>
                            </nav>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pn-section pn-section--soft">
                <div class="pn-container pn-split">
                    <div class="pn-split__copy">
                        <p class="pn-eyebrow pn-reveal">Custom requirement</p>
                        <h2 class="pn-h2 pn-reveal">Have a drawing or a sample?</h2>
                        <p class="pn-reveal">
                            Most of our work is made to order. Send us a drawing, a photo of the sample or a short
                            description, and we will review how to design, develop or manufacture it.
                        </p>
                        <a href="/contact" class="pn-btn pn-btn--dark pn-reveal">Send your requirement <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-split__media pn-reveal">
                        <figure class="pn-figure">
                            <img src="/pnsb_website/static/src/img/work/milled-components.jpg" alt="Machined components made to drawing" loading="lazy" width="800" height="600"/>
                        </figure>
                    </div>
                </div>
            </section>
            <div class="oe_structure" id="pn_products_extra"/>
        </t>
    </template>

    <!-- =====================================================================
         Product page: eCommerce's /shop/<product> rendered with PNSB templates
    ====================================================================== -->
    <template id="shop_product" name="PNSB: Shop Product">
        <t t-call="pnsb_website.pn_layout">
            <t t-set="additional_title" t-value="pnsb_product.name"/>
            <section class="pn-section pn-pdp">
                <div class="pn-container">
                    <nav class="pn-crumbs pn-reveal" aria-label="Breadcrumb">
                        <a href="/shop">Products</a><span aria-hidden="true">/</span>
                        <t t-if="pnsb_category">
                            <a t-att-href="pnsb_category_url" t-out="pnsb_category.name"/><span aria-hidden="true">/</span>
                        </t>
                        <span t-out="pnsb_product.name"/>
                    </nav>
                    <div class="pn-pdp__grid">
                        <div class="pn-pdp__gallery pn-reveal" data-pnsb-gallery="">
                            <figure class="pn-pdp__media">
                                <div class="pn-ind__ruler" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
                                <div class="pn-pdp__frame">
                                    <img t-att-src="website.image_url(pnsb_product, 'image_1024')" t-att-alt="pnsb_product.name"
                                         width="1024" height="768" data-pnsb-gallery-main=""/>
                                </div>
                                <figcaption>
                                    <span>Fig. <span data-pnsb-gallery-index="">01</span></span><span t-out="pnsb_product.name"/>
                                </figcaption>
                            </figure>
                            <div t-if="len(pnsb_images) &gt; 1" class="pn-pdp__thumbs" role="group" aria-label="Product photos">
                                <button t-foreach="pnsb_images" t-as="image" type="button" data-pnsb-gallery-thumb=""
                                        t-attf-class="pn-pdp__thumb #{'is-active' if image_first else ''}"
                                        t-att-data-src="website.image_url(image, 'image_1024')" t-attf-data-index="#{'%02d' % (image_index + 1)}"
                                        t-attf-aria-label="Photo #{image_index + 1}">
                                    <img t-att-src="website.image_url(image, 'image_128')" alt="" loading="lazy" width="128" height="96"/>
                                </button>
                            </div>
                        </div>
                        <div class="pn-pdp__info">
                            <p class="pn-label pn-reveal" t-out="(pnsb_category or pnsb_product.public_categ_ids[:1]).name or pnsb_product.categ_id.name"/>
                            <h1 class="pn-pdp__title pn-reveal" t-out="pnsb_product.name"/>
                            <p class="pn-pdp__lead pn-reveal" t-out="pnsb_product._pnsb_summary()"/>
                            <div class="pn-pdp__actions pn-reveal">
                                <button type="button" class="pn-btn pn-btn--dark pn-btn--lg" data-pnsb-add=""
                                        t-attf-data-id="#{pnsb_product.id}" t-att-data-name="pnsb_product.name"
                                        t-att-data-image="pnsb_product._pnsb_image_url(128)">
                                    <svg class="pn-i"><use href="#pn-i-plus"/></svg><span>Add to enquiry</span>
                                </button>
                                <a href="/contact" class="pn-btn pn-btn--outline pn-btn--lg">Request a Quote <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                            </div>
                            <table class="pn-ind__block pn-pdp__block pn-reveal">
                                <tr t-if="pnsb_product_categories">
                                    <th>Category</th>
                                    <td class="pn-pdp__tags">
                                        <a t-foreach="pnsb_product_categories" t-as="entry" t-att-href="entry['url']" t-out="entry['category'].name"/>
                                    </td>
                                </tr>
                                <tr t-if="pnsb_product_industries">
                                    <th>Industries</th>
                                    <td class="pn-pdp__tags">
                                        <a t-foreach="pnsb_product_industries" t-as="industry" t-att-href="industry.website_url" t-out="industry.name"/>
                                    </td>
                                </tr>
                                <tr><th>Supply</th><td>Made to your drawing or sample</td></tr>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <t t-set="has_description" t-value="pnsb_product.description_ecommerce and not is_html_empty(pnsb_product.description_ecommerce)"/>
            <t t-set="has_story" t-value="pnsb_product.pnsb_website_story and not is_html_empty(pnsb_product.pnsb_website_story)"/>
            <section t-if="has_description or has_story or pnsb_attribute_lines" class="pn-section pn-section--soft">
                <div t-attf-class="pn-container #{'pn-pdp__text' if (has_description or pnsb_attribute_lines) and has_story else ''}">
                    <div t-if="has_description or pnsb_attribute_lines">
                        <div t-if="has_description" class="pn-ihero__content pn-reveal">
                            <p class="pn-label">Description</p>
                            <t t-out="pnsb_product.description_ecommerce"/>
                        </div>
                        <div t-if="pnsb_attribute_lines" class="pn-pdp__specs pn-reveal">
                            <p class="pn-label">Specifications</p>
                            <table class="pn-ind__block pn-pdp__block">
                                <tr t-foreach="pnsb_attribute_lines" t-as="line">
                                    <th t-out="line.attribute_id.name"/>
                                    <td t-out="', '.join(line.value_ids.mapped('name'))"/>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <aside t-if="has_story" class="pn-pdp__story pn-reveal">
                        <p class="pn-label">Development story</p>
                        <div class="pn-ihero__content" t-out="pnsb_product.pnsb_website_story"/>
                    </aside>
                </div>
            </section>

            <!-- Free content edited in the website builder (eCommerce's "Description for the website"). -->
            <div itemprop="description" t-field="product.website_description" class="oe_structure oe_empty pn-pdp__builder"
                 id="product_full_description"/>

            <section t-if="pnsb_related" class="pn-section">
                <div class="pn-container">
                    <div class="pn-head">
                        <div>
                            <p class="pn-label pn-reveal">Related products</p>
                            <h2 class="pn-h2" data-pnsb-split="">You may also need.</h2>
                        </div>
                        <a t-att-href="pnsb_category_url" class="pn-link pn-reveal">All products <svg class="pn-i"><use href="#pn-i-arrow"/></svg></a>
                    </div>
                    <div class="pn-products pn-products--4">
                        <t t-foreach="pnsb_related" t-as="product">
                            <t t-call="pnsb_website.pn_product_card"/>
                        </t>
                    </div>
                </div>
            </section>

            <div class="oe_structure" id="pn_product_extra"/>
            <t t-call="pnsb_website.pn_cta"/>
        </t>
    </template>
</odoo>
