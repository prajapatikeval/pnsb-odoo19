<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_industrial_parts" model="res.groups.privilege">
        <field name="name">Industrial Parts Website</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_industrial_user" model="res.groups">
        <field name="name">User: Handle Quote Requests</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_industrial_parts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_industrial_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_industrial_parts"/>
        <field name="implied_ids" eval="[(4, ref('group_industrial_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- Public / portal visitors only see published catalogue records. -->
        <record id="rule_industrial_product_public" model="ir.rule">
            <field name="name">Industrial product: published only</field>
            <field name="model_id" ref="model_industrial_product"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_category_public" model="ir.rule">
            <field name="name">Industrial category: published only</field>
            <field name="model_id" ref="model_industrial_product_category"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_sector_public" model="ir.rule">
            <field name="name">Industry served: published only</field>
            <field name="model_id" ref="model_industrial_sector"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_product_image_public" model="ir.rule">
            <field name="name">Industrial product image: published products only</field>
            <field name="model_id" ref="model_industrial_product_image"/>
            <field name="domain_force">[('product_id.website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_product_spec_public" model="ir.rule">
            <field name="name">Industrial product spec: published products only</field>
            <field name="model_id" ref="model_industrial_product_spec"/>
            <field name="domain_force">[('product_id.website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_product_size_public" model="ir.rule">
            <field name="name">Industrial product size: published products only</field>
            <field name="model_id" ref="model_industrial_product_size"/>
            <field name="domain_force">[('product_id.website_published', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_industrial_rfq_company" model="ir.rule">
            <field name="name">Quote request: multi-company</field>
            <field name="model_id" ref="model_industrial_rfq"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
